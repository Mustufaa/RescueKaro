# Copy this file to .env in the project root. Never commit .env.

# Database container credentials (used only for this Compose database).
DB_NAME=rescuekaro_db
DB_USERNAME=rescuekaro
DB_PASSWORD=replace-with-a-strong-local-password
DB_PORT=5432

# Host ports. Published services bind only to 127.0.0.1.
FRONTEND_PORT=3000
BACKEND_PORT=8080

# Public browser URL used in generated sticker links. A localhost value only
# opens on this computer; another phone needs a public HTTPS URL or LAN address.
PUBLIC_APP_URL=http://localhost:3000

# Local-only signing secret; replace for any non-local deployment.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Mock OTP for local development only. This is not a production SMS service.
OTP_PROVIDER=mock
OTP_TEST_CODE=000111

# Use simulation only for local development. Set test/live plus provider
# credentials for Razorpay checkout. Secrets stay on the backend.
RAZORPAY_MODE=simulation
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
