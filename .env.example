# Copy this file to .env in the project root. Never commit .env.

# Database container credentials (used only for this Compose database).
DB_NAME=rescuekaro_db
DB_USERNAME=rescuekaro
DB_PASSWORD=replace-with-a-strong-local-password
DB_PORT=5432

# Host ports. Published services bind only to 127.0.0.1.
FRONTEND_PORT=3000
BACKEND_PORT=8080

# Set this to your deployed frontend HTTPS origin before completing a physical
# sticker request. Localhost is useful for digital QR development only; the
# physical sticker wizard rejects it because a phone cannot scan that URL.
PUBLIC_APP_URL=http://localhost:3000

# Local-only signing secret; replace for any non-local deployment.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Compose sends to Mailpit by default. Replace the SMTP settings with a real
# provider to deliver codes to an inbox.
OTP_HASH_SECRET=replace-with-a-separate-random-secret-at-least-32-characters
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=preview@rescuekaro.test
SMTP_FROM_NAME=RescueKaro
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_STARTTLS_REQUIRED=false
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_READ_TIMEOUT_MS=5000
SMTP_WRITE_TIMEOUT_MS=5000
