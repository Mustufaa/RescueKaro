NEXT_PUBLIC_SITE_URL=https://your-vercel-domain.vercel.app
NEXT_PUBLIC_API_BASE_URL=/api

# Demo OTP is public because this frontend currently uses a mock client-side OTP flow.
# Keep this enabled only for demos/testing, not for a real customer production launch.
NEXT_PUBLIC_ENABLE_DEMO_OTP=true
NEXT_PUBLIC_DEMO_OTP_CODE=000111
