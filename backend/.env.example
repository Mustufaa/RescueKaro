# Copy this file to .env for local development. application.yml imports that
# git-ignored file; process and IDE environment variables override its values.
# On Render, RENDER_DATABASE_URL is the internal postgres:// connection string
# supplied by the Blueprint. The backend converts it to JDBC at startup.
# For manual hosting, use either the DB_* fields below or a JDBC DATABASE_URL.
DB_HOST=localhost
DB_PORT=5432
SPRING_PROFILES_ACTIVE=dev
DB_NAME=rescuekaro_db
DB_USERNAME=postgres
DB_PASSWORD=replace-with-a-strong-local-password
JWT_SECRET=replace-with-at-least-32-random-characters
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080
# Set a public HTTPS frontend origin before issuing physical sticker QR codes.
PUBLIC_APP_URL=http://localhost:3000
SERVER_PORT=8080
OTP_HASH_SECRET=replace-with-a-separate-random-secret-at-least-32-characters
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=RescueKaro
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_STARTTLS_REQUIRED=true
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_READ_TIMEOUT_MS=5000
SMTP_WRITE_TIMEOUT_MS=5000
