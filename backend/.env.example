# Copy this file to .env for local development. application.yml imports that
# git-ignored file; process and IDE environment variables override its values.
DB_HOST=localhost
DB_PORT=5432
SPRING_PROFILES_ACTIVE=dev
DB_NAME=rescuekaro_db
DB_USERNAME=postgres
DB_PASSWORD=replace-with-a-strong-local-password
JWT_SECRET=replace-with-at-least-32-random-characters
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080
PUBLIC_APP_URL=http://localhost:3000
SERVER_PORT=8080
OTP_PROVIDER=mock
OTP_TEST_CODE=000111
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=simulation
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
