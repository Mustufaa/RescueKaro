{
  "info": {
    "name": "RescueKaro API v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" },
    { "key": "publicToken", "value": "replace-me" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" }
    },
    {
      "name": "Send registration OTP",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"phone\":\"+919876543210\",\"purpose\":\"registration\"}" },
        "url": "{{baseUrl}}/auth/otp/send"
      }
    },
    {
      "name": "Verify OTP",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"requestId\":\"replace-uuid\",\"code\":\"000111\"}" },
        "url": "{{baseUrl}}/auth/otp/verify"
      }
    },
    {
      "name": "Products",
      "request": { "method": "GET", "url": "{{baseUrl}}/products" }
    },
    {
      "name": "Resolve public QR",
      "request": { "method": "GET", "url": "{{baseUrl}}/public/qr/{{publicToken}}" }
    }
  ]
}
