{
  "info": {
    "name": "RescueKaro API v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" },
    { "key": "publicToken", "value": "replace-me" },
    { "key": "challengeId", "value": "replace-uuid" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" }
    },
    {
      "name": "Register and send email OTP",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"fullName\":\"Test User\",\"phone\":\"+919876543210\",\"email\":\"test@example.com\",\"password\":\"Abc123\",\"confirmPassword\":\"Abc123\"}" },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "Verify registration email OTP",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"requestId\":\"{{challengeId}}\",\"code\":\"123456\"}" },
        "url": "{{baseUrl}}/auth/verify-email"
      }
    },
    {
      "name": "Login and send email OTP",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"email\":\"test@example.com\",\"password\":\"Abc123\"}" },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Verify login email OTP",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"requestId\":\"{{challengeId}}\",\"code\":\"123456\"}" },
        "url": "{{baseUrl}}/auth/verify-login-otp"
      }
    },
    {
      "name": "Resend email OTP",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"requestId\":\"{{challengeId}}\"}" },
        "url": "{{baseUrl}}/auth/resend-otp"
      }
    },
    {
      "name": "Request password reset email OTP",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"email\":\"test@example.com\"}" },
        "url": "{{baseUrl}}/auth/password/reset/request"
      }
    },
    {
      "name": "Reset password with email OTP",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"requestId\":\"{{challengeId}}\",\"code\":\"123456\",\"newPassword\":\"Def456\",\"confirmPassword\":\"Def456\"}" },
        "url": "{{baseUrl}}/auth/password/reset"
      }
    },
    {
      "name": "Products",
      "request": { "method": "GET", "url": "{{baseUrl}}/products" }
    },
    {
      "name": "Resolve public QR",
      "request": { "method": "GET", "url": "{{baseUrl}}/public/qr/{{publicToken}}" }
    }
  ]
}
