# Frontend metadata origin. Set this to the deployed HTTPS site in production.
# Sticker QR issuance uses the backend PUBLIC_APP_URL setting.
SITE_URL=http://localhost:3000
# Set this before npm run build on Render. It accepts a full HTTPS backend URL,
# a Render *.onrender.com hostname (Free plan), or an internal host:port (paid
# backend), with optional /api/v1 suffix.
# The Next.js server proxies /api/v1 to the backend; browsers use same-origin.
API_INTERNAL_BASE_URL=http://localhost:8080/api/v1
